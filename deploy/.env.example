# =============================================================================
# FlowERP — VPS production environment template
# =============================================================================
# Copy to the repo root on the VPS:
#
#   cp deploy/.env.example .env.production
#   # fill secrets, then:
#   ./scripts/deploy.sh
#
# Never commit a filled-in file. Placeholders only — no real credentials.
#
# Local development:
#   apps/api/.env.local   (from apps/api/.env.example)
#   apps/web/.env.local   (from apps/web/.env.example)
#   docker compose -f docker-compose.local.yml up -d   # Postgres + Traccar
# =============================================================================

# --- Public addresses (Caddy) ----------------------------------------------
# DNS A/AAAA for both hostnames must point at this VPS before first TLS issue.
SITE_ADDRESS=flowerp.uz
API_ADDRESS=api.flowerp.uz
HTTP_PORT=80
HTTPS_PORT=443

# Browser-visible origin (marketing / app). Feeds API CORS_ORIGIN.
PUBLIC_ORIGIN=https://flowerp.uz

# --- Database --------------------------------------------------------------
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=erp_prod
# Compose builds DATABASE_URL from the above. Override only if you must:
# DATABASE_URL=postgresql://erp:CHANGE_ME@postgres:5432/erp_prod?schema=public&connection_limit=30&pool_timeout=10&connect_timeout=30&statement_timeout=15000

# --- Auth (required) -------------------------------------------------------
# openssl rand -base64 48 | tr '+/' '-_' | tr -d '='
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_DAYS=30
PASSWORD_RESET_EXPIRES_IN_MINUTES=60

# Frontend origin for invite / portal links (must match what users open)
APP_PUBLIC_URL=https://flowerp.uz
INVITATION_EXPIRES_IN_DAYS=7

# Encrypts DB-stored payment / email-provider credentials.
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
APP_SECRET=

# --- Mail -------------------------------------------------------------------
# Required for staff password recovery and invitation delivery in production.
# SMTP_URL accepts only smtp:// or smtps://, for example:
# smtp://USERNAME:PASSWORD@smtp.example.com:587 (URL-encode credentials).
# smtp:// requires STARTTLS; smtps:// uses implicit TLS. Both verify the
# certificate against the URL hostname with TLS 1.2 or newer.
# MAIL_FROM is required when SMTP_URL is set; use a valid mailbox such as
# FlowERP <no-reply@example.com>. SMTP_CONNECT_HOST optionally changes only the
# TCP destination (for example, to a fixed IP), while TLS still verifies the
# SMTP_URL hostname. Delivery is synchronous with 5s connection/greeting and
# 10s socket timeouts and no API retry.
# Leave SMTP_URL blank only when intentionally accepting email features as
# unavailable; production still starts and uses the unavailable mail provider.
SMTP_URL=
MAIL_FROM=
SMTP_CONNECT_HOST=
LEADS_NOTIFY_EMAIL=

# --- Redis -----------------------------------------------------------------
# Compose sets redis://redis:6379 automatically. Override only for external Redis.
# REDIS_URL=redis://redis:6379

# --- Database backups -------------------------------------------------------
# Production requires a verified offsite copy. This must be an absolute path to
# an operator-owned executable; do not put provider credentials in this file.
# The wrapper receives exactly: <dump.sql.gz> <dump.sql.gz.sha256>. It must
# upload both with provider-side encryption, verify the remote object/checksum,
# and exit nonzero unless the upload and verification both succeed.
REQUIRE_OFFSITE_BACKUP=true
OFFSITE_WRAPPER=/usr/local/bin/flowerp-offsite-backup
AWS_REGION=eu-north-1
S3_BUCKET=flowerp-812063706887-eu-north-1-an
S3_BACKUP_PREFIX=backups/
# Retry settings are positive integers, capped at 10 attempts / 3600 seconds.
OFFSITE_MAX_ATTEMPTS=3
OFFSITE_RETRY_BACKOFF_SECONDS=30
# Host directory mounted read-only into node-exporter's textfile collector.
NODE_EXPORTER_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

# --- AI Copilot (optional) -------------------------------------------------
# Leave AI_PROVIDER empty to disable. Valid: anthropic | openai | gemini | ollama
AI_PROVIDER=
AI_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_MAX_TOKENS=4096
AI_TEMPERATURE=0.2
AI_MAX_TOOL_ITERATIONS=8
AI_REQUEST_TIMEOUT_MS=120000
AI_RATE_LIMIT_PER_HOUR=120

# --- Webhooks --------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5

# --- Billing webhooks (optional — only if that provider is live) -----------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLICK_SECRET_KEY=
PAYME_MERCHANT_ID=
PAYME_SECRET_KEY=

# --- Mapbox (Fleet Tracking) ----------------------------------------------
# Public token is baked into the web image at build time (pk.* only) via
# docker-compose build.args → apps/web/Dockerfile ARG/ENV.
# Secret token is injected into the API container at runtime (sk.* only).
VITE_MAPBOX_ACCESS_TOKEN=
MAPBOX_SECRET_TOKEN=
# Optional SSE admission limits (defaults match configuration.ts).
# TELEMATICS_SSE_MAX_CONNECTIONS_PER_ORG=20
# TELEMATICS_SSE_MAX_CONNECTIONS_GLOBAL=500

# --- Fleet Tracking: Traccar GPS gateway ------------------------------------
# Raw device-facing TCP ports, published directly (never through Caddy — see
# docs/TRACCAR_SETUP.md). Override only if the port is already in use on the
# VPS; the device/NTC Configurator server port must then be updated to match.
# TRACCAR_TELTONIKA_PORT=5027
# TRACCAR_NAVTELECOM_PORT=5221
#
# Traccar's own admin UI (port 8082) is intentionally NOT published here —
# it stays internal to the compose network. Reach it for one-time device
# setup via an SSH tunnel: ssh -L 8082:localhost:8082 <vps-user>@<vps-host>,
# then open http://localhost:8082 in a local browser. Change the default
# admin/admin login the first time you do this.

# --- Observability ---------------------------------------------------------
GIT_COMMIT_SHA=unknown
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Deploy image (set by CI; optional locally) ----------------------------
# API_IMAGE=ghcr.io/<owner>/erp-api:latest
