# The backend's own origin (no /api prefix — see constants/config.ts).
# Point this at your machine's LAN IP when testing on a physical device, or
# 10.0.2.2 for the Android emulator. Must be prefixed EXPO_PUBLIC_ to be
# readable at runtime (Expo only inlines env vars with that prefix).
EXPO_PUBLIC_API_URL=http://localhost:4000
